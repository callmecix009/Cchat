# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Supabase (Dashboard -> Connect button)
# DATABASE_URL = transaction pooler, port 6543
# DIRECT_URL   = session pooler / migrations, port 5432
# NOTE: encode special chars in password (# becomes %23)
DATABASE_URL=
DIRECT_URL=

# Clerk webhook signing secret (Clerk Dashboard -> Webhooks)
CLERK_WEBHOOK_SECRET=

# DeepSeek AI (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Meta WhatsApp Embedded Signup (developers.facebook.com) - needed later
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
